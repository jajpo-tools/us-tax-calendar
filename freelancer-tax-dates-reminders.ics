BEGIN:VEVENT
UID:form-1099-nec-2026@jajpo.com
DTSTAMP:20261105T000000Z
DTSTART;VALUE=DATE:20270201
DTEND;VALUE=DATE:20270202
SUMMARY:Forms 1099-NEC due for payments made in 2026
DESCRIPTION:Send Form 1099-NEC to each contractor you paid $2\,000 or more 
 for services in 2026 in the course of your business\, and file it with the
  IRS. Check who needs one with the JAJPO 1099-NEC Checker. https://jajpo.c
 om/taxes/1099-nec-checker/ General information\, not tax advice. Dates can
  change\, for example after a disaster declaration\; check IRS.gov.
URL:https://jajpo.com/taxes/1099-nec-checker/
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Forms 1099-NEC due for payments made in 2026
TRIGGER:-P7D
END:VALARM
END:VEVENT
